#!/usr/bin/env python3
"""Brama pre-push: push agenta, który wysyła HEAD, przechodzi po ruff i mypy dla obu systemów.

Push człowieka przechodzi bez sprawdzania i bez słowa. Agenta rozpoznaje zmienna ``AI_AGENT`` (Claude Code,
opencode) albo ``CLAUDECODE``, które agent ustawia w swoim terminalu.

Push agenta, który wysyła tag ``refs/tags/v*``, brama odrzuca, zanim cokolwiek sprawdzi: tag Wydania trafia do
taty (ADR 0014), a agenci pushują z konta Maksa, więc GitHub ich nie odróżni. Tag Wydania wypycha tylko narzędzie
Wydań (#316), które ustawia ``MAXIMISEART_WYDANIE=1``; żaden agent nie ustawia tej zmiennej sam. Granica: brama
widzi tylko ``git push`` z hookami, więc ``git push --no-verify``, ``gh release create``, ``gh api`` i stronę GitHuba
łapie tylko przegląd.

Kroki bierze z ``tools/ci_lokalnie.py``, uruchomionego Pythonem z ``.venv`` checkoutu. Włącza ją
``tools/setup_worktree.py`` (``core.hooksPath``); git uruchamia ją w katalogu głównym checkoutu.

Przed krokami drukuje dwie linie, które tylko informują: werdykt ``tools/praca_w_toku.py --aktualizacja``, czy
aktualizować gałąź z ``origin/main``, i skille ``verify-*`` do załadowania z ``tools/skille_dla_zmiany.py``. Gdy
narzędzie się nie uda, brama drukuje ``AKTUALIZACJA: nieznana (…)`` albo ``SKILLE VERIFY: nieznane (…)``, a wynik
pushu się nie zmienia.

Hook biegnie systemowym Pythonem (na Macu 3.9), więc ten plik, ``tools/lib/repo.py`` i ``tools/lib/potomne.py`` ruff
sprawdza pod 3.9 (``per-file-target-version`` w ``pyproject.toml``).
"""

from __future__ import annotations

from dataclasses import dataclass
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from repo import ROOT
import repo

AGENT_MARKERS = ("AI_AGENT", "CLAUDECODE")
VENV_PYTHON = Path(".venv/Scripts/python.exe" if sys.platform == "win32" else ".venv/bin/python")
COMMAND = (str(VENV_PYTHON), "tools/ci_lokalnie.py", "--tylko", "ruff,mypy", "--do-pierwszego-bledu")
NOTE_TIMEOUT_S = 5
CHECKS = "sprawdzam ruff i mypy (macOS i Windows) przez tools/ci_lokalnie.py; resztę sprawdza CI na GitHubie"


@dataclass(frozen=True)
class Decision:
    message: str
    checks: bool


RELEASE_OVERRIDE = "MAXIMISEART_WYDANIE"
RELEASE_TAGS = "refs/tags/v"
HUMAN = Decision("", checks=False)
NOT_HEAD = Decision("push nie wysyła HEAD (usunięcie gałęzi albo inna gałąź), więc bez sprawdzania", checks=False)
CLEAN = Decision(CHECKS, checks=True)
DIRTY = Decision(
    f"{CHECKS}; checkout ma niezacommitowane zmiany, więc werdykt dotyczy drzewa roboczego, nie tylko wysyłanego commitu",
    checks=True,
)


@dataclass(frozen=True)
class Note:
    """Linia narzędzia, którą brama drukuje przed krokami: ostatnia linia wyjścia, gdy zaczyna się od ``prefix``."""

    command: tuple[str, ...]
    prefix: str
    unknown: str


NOTES = (
    Note((str(VENV_PYTHON), "tools/praca_w_toku.py", "--aktualizacja"), "AKTUALIZACJA: ", "nieznana"),
    Note((str(VENV_PYTHON), "tools/skille_dla_zmiany.py"), "SKILLE VERIFY: ", "nieznane"),
)


def _decide(pushed: set[str]) -> Decision:
    if not any(os.environ.get(marker) for marker in AGENT_MARKERS):
        return HUMAN
    if repo.git(ROOT, "rev-parse", "HEAD").strip() not in pushed:
        return NOT_HEAD
    return DIRTY if repo.git(ROOT, "status", "--porcelain").strip() else CLEAN


def _print_note(note: Note) -> None:
    try:
        import potomne

        done = potomne.run(note.command, cwd=Path.cwd(), timeout=NOTE_TIMEOUT_S)
    except Exception as error:  # noqa: BLE001 - linia tylko informuje, więc żaden błąd narzędzia nie zmienia wyniku pushu
        reason = f"{type(error).__name__}: {error}"
    else:
        last = (done.stdout.strip().splitlines() or [""])[-1]
        if last.startswith(note.prefix):
            print(last, flush=True)
            return
        reason = f"{note.command[1]}: " + (done.stderr.strip().splitlines() or [f"kod {done.returncode}"])[-1]
    print(f"{note.prefix}{note.unknown} ({reason})", flush=True)


def main() -> int:
    refs = [line.split() for line in sys.stdin if line.strip()]
    agent = any(os.environ.get(marker) for marker in AGENT_MARKERS)
    tags = [remote_ref for _, _, remote_ref, _ in refs if remote_ref.startswith(RELEASE_TAGS)]
    if agent and tags and os.environ.get(RELEASE_OVERRIDE) != "1":
        print(f"pre-push: agent nie wypycha tagów Wydania ({', '.join(tags)}); robi to tylko narzędzie Wydań.", flush=True)
        return 1
    decision = _decide({local_sha for _, local_sha, _, _ in refs})
    if decision.message:
        print(f"pre-push: {decision.message}.", flush=True)
    if not decision.checks:
        return 0
    if not VENV_PYTHON.exists():
        print("pre-push: brak .venv; utwórz je przez tools/setup_worktree.py i ponów push.", flush=True)
        return 1
    for note in NOTES:
        _print_note(note)
    if sys.platform == "win32":  # tools/setup_worktree.py nie włącza bramy na Windows
        import potomne

        return potomne.run(COMMAND, cwd=Path.cwd(), echo=True).returncode
    # Hook staje się ci_lokalnie, więc sygnał dla samego hooka też kończy sprawdzenie.
    os.execv(COMMAND[0], COMMAND)


if __name__ == "__main__":
    raise SystemExit(main())

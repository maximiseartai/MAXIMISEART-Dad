{
  "name": "centrum-rozliczen",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "contract": "node scripts/contract.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "unused": "knip",
    "duplicates": "jscpd",
    "rules": "node scripts/rules.mjs && node --test scripts/field-use.test.mjs",
    "build": "tsc -b && vite build",
    "regen": "npm run contract && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "jscpd": "^5.4.1",
    "knip": "^6.42.0",
    "oxlint": "1.88.0",
    "typescript": "~6.0.2",
    "vite": "^8"
  }
}

__pycache__/
*.egg-info/
# mypy wpisuje własny .gitignore do cache dopiero na końcu przebiegu, więc przerwany przebieg zostawia cache dla git add -A.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
# Bez ukośnika: agent dowiązuje .venv z innego worktree, a wzorzec katalogu nie łapie dowiązania.
.venv
*.pyc
*.xlsx
*.xlsm
*.xlsb
*.xls
~$*
._*
reports/
logs/
.rozliczenia-metrics.jsonl
.verification/
.przygotowanie-pliku-zbiorczego-metrics.jsonl
.DS_Store
# Pliki Centrum w config/ (Uwagi taty, adresy Skrzynki, klucz) nie trafiają do publicznego repozytorium.
config/*
!config/worker_mapping.example.yaml
node_modules/
.benchmark/
# Czasy jednostek zadania CI (tools/ci/czasy_ci.py), plan runu (tools/plan_ci.py) i flaky testy z kwarantanną (tools/lib/niestabilne_testy.py), artefakty runu.
.ci-czasy/
.ci-plan/
.ci-niestabilne/

# Kopie INTERMAX i metryki Uporządkowania INTERMAX na komputerze taty.
Kopie INTERMAX/
.uporzadkowanie-intermax-metrics.jsonl

# Profil przeglądarki okna efenix (logowanie taty) i metryki Wyceny w efenix na komputerze taty.
przegladarka-efenix/
.wycena-efenix-metrics.jsonl

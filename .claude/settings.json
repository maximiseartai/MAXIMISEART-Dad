{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "permissions": {
    "deny": [
      "Edit(~/.claude/projects/*/memory/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/czekanie.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/czekanie.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/tozsamosc.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/tozsamosc.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/praca_w_tle.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/praca_w_tle.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/zgoda.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/zgoda.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

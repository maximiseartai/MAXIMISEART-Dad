{
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "GIT_AUTHOR_NAME": "MAXIMISEART-AI",
    "GIT_AUTHOR_EMAIL": "281159351+MAXIMISEART-AI@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "MAXIMISEART-AI",
    "GIT_COMMITTER_EMAIL": "281159351+MAXIMISEART-AI@users.noreply.github.com"
  },
  "permissions": {
    "deny": [
      "Edit(~/.claude/projects/*/memory/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/czekanie.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/czekanie.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/ciezkie.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/ciezkie.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/praca_w_tle.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/praca_w_tle.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/zgoda.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/zgoda.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__t3-code__delegate_task",
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/straznik_koordynatora.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/straznik_koordynatora.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/python_sesji.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/python_sesji.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "test ! -f \"$CLAUDE_PROJECT_DIR/tools/hooks/straznik_koordynatora.py\" || python3 \"$CLAUDE_PROJECT_DIR/tools/hooks/straznik_koordynatora.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
